{
  "formatVersion": 2,
  "engines": [
    {
      "id": "cardano-binary",
      "displayName": "cardano-binary (Haskell)",
      "homepage": "https://github.com/IntersectMBO/cardano-base",
      "note": "Not separately versioned in a way a tool install exposes. It ships inside each Haskell binary, so the tool version is the only version there is."
    },
    {
      "id": "cardano-serialization-lib",
      "displayName": "cardano-serialization-lib",
      "homepage": "https://github.com/Emurgo/cardano-serialization-lib",
      "package": "@emurgo/cardano-serialization-lib-nodejs"
    },
    {
      "id": "cardano-sdk-core",
      "displayName": "cardano-js-sdk core",
      "homepage": "https://github.com/input-output-hk/cardano-js-sdk",
      "package": "@cardano-sdk/core"
    },
    {
      "id": "gouroboros",
      "displayName": "gouroboros",
      "homepage": "https://github.com/blinklabs-io/gouroboros"
    }
  ],
  "tools": [
    {
      "id": "cardano-cli",
      "displayName": "cardano-cli",
      "homepage": "https://github.com/IntersectMBO/cardano-cli",
      "adapter": "cardano-cli-binary",
      "discovery": {
        "type": "github-releases",
        "repo": "IntersectMBO/cardano-cli",
        "tagPrefix": "cardano-cli-"
      },
      "channels": ["current", "previous", "beta"],
      "engine": {
        "id": "cardano-binary",
        "relation": "depends"
      }
    },
    {
      "id": "cardano-address",
      "displayName": "cardano-address",
      "homepage": "https://github.com/IntersectMBO/cardano-addresses",
      "adapter": "cardano-address-binary",
      "discovery": {
        "type": "github-releases",
        "repo": "IntersectMBO/cardano-addresses",
        "tagPrefix": ""
      },
      "channels": ["current", "previous"],
      "engine": {
        "id": "cardano-binary",
        "relation": "reimplements"
      }
    },
    {
      "id": "cardano-serialization-lib-nodejs",
      "displayName": "cardano-serialization-lib (nodejs)",
      "homepage": "https://github.com/Emurgo/cardano-serialization-lib",
      "package": "@emurgo/cardano-serialization-lib-nodejs",
      "adapter": "npm-csl",
      "discovery": {
        "type": "npm"
      },
      "channels": ["current", "previous", "beta"],
      "engine": {
        "id": "cardano-serialization-lib",
        "relation": "own"
      }
    },
    {
      "id": "meshsdk-core",
      "displayName": "MeshJS core",
      "homepage": "https://github.com/MeshJS/mesh",
      "package": "@meshsdk/core",
      "adapter": "npm-native-script-json",
      "adapterOptions": {
        "exportName": "resolveNativeScriptHash",
        "slotEncoding": "string"
      },
      "discovery": {
        "type": "npm"
      },
      "channels": ["current", "previous", "beta"],
      "engine": {
        "id": "cardano-sdk-core",
        "relation": "depends",
        "via": ["@meshsdk/core-cst"]
      }
    },
    {
      "id": "gouroboros",
      "displayName": "gouroboros",
      "homepage": "https://github.com/blinklabs-io/gouroboros",
      "adapter": "gouroboros",
      "discovery": {
        "type": "github-releases",
        "repo": "blinklabs-io/gouroboros",
        "tagPrefix": "v"
      },
      "channels": ["current", "previous"],
      "paths": ["construct", "decode"],
      "engine": {
        "id": "gouroboros",
        "relation": "own"
      }
    }
  ]
}
