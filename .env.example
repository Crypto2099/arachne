# Chain exercises only. The offline unit and conformance suites need none of this.
# Nothing here is read unless `npm run test:chain` or `arachne chain exercise` runs.

# Which public testnet to exercise against: preview | preprod
ARACHNE_NETWORK=preview

# Blockfrost project id for the matching network. Koios needs no key; set
# ARACHNE_PROVIDER=koios to use it instead.
ARACHNE_PROVIDER=blockfrost
BLOCKFROST_PROJECT_ID=

# Funding wallet for exercises. This pays fees and seeds every script address,
# so it holds real testnet ADA and belongs in .env.local, never in the repo.
ARACHNE_FUNDING_MNEMONIC=

# Cosigner key material for the generated scripts. A seed, not a wallet: keys
# are derived deterministically from it so a vector's key hashes reproduce.
ARACHNE_COSIGNER_SEED=
